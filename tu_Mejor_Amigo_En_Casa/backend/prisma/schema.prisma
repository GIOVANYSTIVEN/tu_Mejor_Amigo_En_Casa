// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuarios {
  idusuariosGevt       Int       @id @default(autoincrement())
  Nombre_completoGevt  String 
  CorreoGevt           String    @unique
  PasswordGevt         String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Razas {
  idrazasGevt          Int       @id @default(autoincrement())
  NombreGevt           String
  Mascotas             Mascotas[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Categorias {
  idcategoriasGevt     Int       @id @default(autoincrement())
  NombreGevt           String
  Mascotas             Mascotas[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Genero {
  idgeneroGevt         Int       @id @default(autoincrement())
  NombreGevt           String
  Mascotas             Mascotas[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum Estado {
  ADOPTADO 
  PENDIENTE
}

model Mascotas {
  idmascotasGevt       Int       @id @default(autoincrement())
  NombreGevt           String
  idrazasGevt          Int
  idcategoriasGevt     Int
  idgeneroGevt         Int
  Genero               Genero    @relation(fields: [idgeneroGevt], references: [idgeneroGevt])
  Categorias           Categorias @relation(fields: [idcategoriasGevt], references: [idcategoriasGevt])
  Razas                Razas     @relation(fields: [idrazasGevt], references: [idrazasGevt])
  estado               Estado  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  Foto                 String?
  latitude             Float? 
  longitude            Float? 
}